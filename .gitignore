# Secrets and environment files
.env
.env.local
*.env
!*.env.tpl

# Generated by op inject — never commit resolved secrets
**/*.env.local

# TLS / certificates
*.key
*.pem
*.crt
acme.json

# 1Password Connect credentials
1password-credentials.json

# Frigate resolved config (contains camera credentials)
frigate/config/config.yml

# Recyclarr resolved config (contains Sonarr/Radarr API keys)
mediaserver/recyclarr/recyclarr.yml

# Deploy marker — per-host state (last SHA docker01 finished deploying),
# written by the Deploy workflow. Lives here because this directory is the
# only host path bind-mounted into the runner container.
.deployed-sha

# macOS
.DS_Store

# Claude Code project directory (contains personal paths/SSH commands)
.claude/

# Editor
.vscode/
*.swp
*.swo
