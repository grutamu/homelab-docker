{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "docker:enableMajor"
  ],
  "timezone": "America/Chicago",
  "schedule": ["every weekend"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": ["renovate"],
  "automerge": true,
  "automergeType": "pr",
  "enabledManagers": ["docker-compose"],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Never automerge major versions",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Postgres major upgrades require a manual pg_dump/restore migration — recreating on a new major breaks the data dir. Don't propose them.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/(^|/)postgres$/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Require manual review for pocket-id (auth provider — outage locks out all services)",
      "matchFileNames": ["pocket-id/**"],
      "groupName": "pocket-id stack",
      "automerge": false
    },
    {
      "description": "Require manual review for immich (postgres DB migrations can be irreversible)",
      "matchFileNames": ["immich/**"],
      "groupName": "immich stack",
      "automerge": false
    },
    {
      "description": "Require manual review for traefik majors (gateway — outage takes down everything)",
      "matchFileNames": ["traefik/**"],
      "groupName": "traefik stack"
    },
    {
      "description": "Group all monitoring stack updates",
      "matchFileNames": ["monitoring/**"],
      "groupName": "monitoring stack"
    },
    {
      "description": "Group all mediaserver stack updates",
      "matchFileNames": ["mediaserver/**"],
      "groupName": "mediaserver stack"
    },
    {
      "description": "Group all paperless updates",
      "matchFileNames": ["paperless/**"],
      "groupName": "paperless stack"
    },
    {
      "description": "Group all netbox updates",
      "matchFileNames": ["netbox/**"],
      "groupName": "netbox stack"
    },
    {
      "description": "Group all frigate updates",
      "matchFileNames": ["frigate/**"],
      "groupName": "frigate stack"
    },
    {
      "description": "Group 1Password Connect updates",
      "matchFileNames": ["1password/**"],
      "groupName": "1password stack"
    },
    {
      "description": "Shelfarr ships ~2 releases/day — batch into a single monthly PR instead of one per weekend run",
      "matchFileNames": ["shelfarr/**"],
      "groupName": "shelfarr stack",
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "description": "Never open digest-only PRs — upstream image rebuilds create constant churn with no version change. All images are pinned to real tags.",
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Ignore stable/release pseudo-tags (Frigate)",
      "matchCurrentValue": "/^(stable|release)$/",
      "enabled": false
    }
  ]
}
