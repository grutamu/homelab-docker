{
  "name": "unifi_network",
  "transport": "stdio",
  "description": "UniFi Network (UDM Pro) — clients, devices, firewall policies",
  "command": "uvx",
  "args": ["unifi-network-mcp==0.24.1"],
  "session_mode": "stateless",
  "env": {
    "UNIFI_NETWORK_HOST": "${UNIFI_HOST}",
    "UNIFI_NETWORK_USERNAME": "${UNIFI_USERNAME}",
    "UNIFI_NETWORK_PASSWORD": "${UNIFI_PASSWORD}",
    "UNIFI_NETWORK_VERIFY_SSL": "false"
  }
}
