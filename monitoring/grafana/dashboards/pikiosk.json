    {
      "title": "WiFi & Watchdog Events",
      "type": "logs",
      "description": "Curated view of the BCM43430 fault. The signatures to look for: 'brcmf_sdio_isr: failed backplane access' and 'mmc1: Got command interrupt' are the SDIO wedge itself; repeated wpa_supplicant/carrier lines are the drop churn that has historically preceded a hang. pikiosk-netwatch lines show the recovery ladder firing. NOTE: logs ship over the network, so the wedge itself will be MISSING here — this shows the run-up, and the persistent journal plus /var/lib/systemd/pstore on the Pi hold the moment of death.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 86
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{host=\"pikiosk\"} |~ \"(?i)brcmfmac|backplane|mmc1|wpa_supplicant|netwatch|carrier|deauth|disconnect\"",
          "queryType": "range"
        }
      ]
    },
    {
      "title": "All Kiosk Logs",
