{
  "title": "GPU Host",
  "uid": "gpu-host",
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["gpu", "hardware"],
  "description": "NVIDIA RTX 3090 box (gpu-host / hermes, 192.168.1.43). GPU metrics from nvidia_gpu_exporter :9835, system metrics from node-exporter :9100, both scraped over Tailscale. Panels select on job, not instance. Grouped into rows by component; GPU temperature and fan live under Fans & Temps rather than GPU.",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 1,
      "title": "GPU Utilization",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.75},
              {"color": "red", "value": 0.95}
            ]
          }
        }
      },
      "targets": [
        {"expr": "nvidia_smi_utilization_gpu_ratio{job=\"gpu-host-gpu\"}", "instant": true, "legendFormat": "gpu"}
      ]
    },
    {
      "id": 2,
      "title": "GPU Temperature",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 83}
            ]
          }
        }
      },
      "targets": [
        {"expr": "nvidia_smi_temperature_gpu{job=\"gpu-host-gpu\"}", "instant": true, "legendFormat": "temp"}
      ]
    },
    {
      "id": 3,
      "title": "VRAM Used",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.85},
              {"color": "red", "value": 0.95}
            ]
          }
        }
      },
      "targets": [
        {"expr": "nvidia_smi_memory_used_bytes{job=\"gpu-host-gpu\"} / nvidia_smi_memory_total_bytes{job=\"gpu-host-gpu\"}", "instant": true, "legendFormat": "vram"}
      ]
    },
    {
      "id": 4,
      "title": "GPU Power",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "red", "value": 400}
            ]
          }
        }
      },
      "targets": [
        {"expr": "nvidia_smi_power_draw_watts{job=\"gpu-host-gpu\"}", "instant": true, "legendFormat": "power"}
      ]
    },
    {
      "id": 5,
      "title": "Host CPU",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "targets": [
        {"expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"gpu-host-node\",mode=\"idle\"}[5m])) * 100)", "instant": true, "legendFormat": "cpu"}
      ]
    },
    {
      "id": 6,
      "title": "Host RAM",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 92}
            ]
          }
        }
      },
      "targets": [
        {"expr": "(1 - (node_memory_MemAvailable_bytes{job=\"gpu-host-node\"} / node_memory_MemTotal_bytes{job=\"gpu-host-node\"})) * 100", "instant": true, "legendFormat": "ram"}
      ]
    },

    {
      "id": 101,
      "type": "row",
      "title": "GPU",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 10,
      "title": "Utilization",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Compute and memory-bandwidth utilization. Both are ratios, so they share one axis.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "nvidia_smi_utilization_gpu_ratio{job=\"gpu-host-gpu\"}", "legendFormat": "compute"},
        {"expr": "nvidia_smi_utilization_memory_ratio{job=\"gpu-host-gpu\"}", "legendFormat": "memory bandwidth"}
      ]
    },
    {
      "id": 11,
      "title": "VRAM",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "24 GB card. A resident model shows as a flat plateau; total is drawn as a ceiling reference.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "total"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}
            ]
          }
        ]
      },
      "targets": [
        {"expr": "nvidia_smi_memory_used_bytes{job=\"gpu-host-gpu\"}", "legendFormat": "used"},
        {"expr": "nvidia_smi_memory_reserved_bytes{job=\"gpu-host-gpu\"}", "legendFormat": "reserved"},
        {"expr": "nvidia_smi_memory_total_bytes{job=\"gpu-host-gpu\"}", "legendFormat": "total"}
      ]
    },
    {
      "id": 30,
      "title": "Clocks",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "nvidia_smi_clocks_current_graphics_clock_hz{job=\"gpu-host-gpu\"}", "legendFormat": "graphics"},
        {"expr": "nvidia_smi_clocks_current_sm_clock_hz{job=\"gpu-host-gpu\"}", "legendFormat": "sm"},
        {"expr": "nvidia_smi_clocks_current_memory_clock_hz{job=\"gpu-host-gpu\"}", "legendFormat": "memory"}
      ]
    },
    {
      "id": 22,
      "title": "Power Draw",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Draw against the enforced limit. Sustained contact with the limit line means power-capped, which the throttle panel confirms.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "enforced limit"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}
            ]
          }
        ]
      },
      "targets": [
        {"expr": "nvidia_smi_power_draw_watts{job=\"gpu-host-gpu\"}", "legendFormat": "draw"},
        {"expr": "nvidia_smi_enforced_power_limit_watts{job=\"gpu-host-gpu\"}", "legendFormat": "enforced limit"}
      ]
    },
    {
      "id": 31,
      "title": "Throttle Reasons",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "1 = actively throttling for that reason. sw power cap riding at 1 under load is normal for a 3090; thermal slowdown is not.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "lineInterpolation": "stepAfter"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "nvidia_smi_clocks_event_reasons_sw_power_cap{job=\"gpu-host-gpu\"}", "legendFormat": "sw power cap"},
        {"expr": "nvidia_smi_clocks_event_reasons_sw_thermal_slowdown{job=\"gpu-host-gpu\"}", "legendFormat": "sw thermal"},
        {"expr": "nvidia_smi_clocks_event_reasons_hw_thermal_slowdown{job=\"gpu-host-gpu\"}", "legendFormat": "hw thermal"},
        {"expr": "nvidia_smi_clocks_event_reasons_hw_power_brake_slowdown{job=\"gpu-host-gpu\"}", "legendFormat": "hw power brake"}
      ]
    },

    {
      "id": 107,
      "type": "row",
      "title": "llama.cpp",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "panels": []
    },
    {
      "id": 70,
      "title": "Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Tokens per second of wall-clock time, so idle stretches drag the line toward zero. This is 'how much work did the box do', not 'how fast is it when working' — for that see Decode Speed. Prompt tokens spike far above generated ones because a cache miss re-ingests the whole conversation in one batch.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "tok/s"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(llamacpp:tokens_predicted_total{job=\"gpu-host-llama\"}[5m])", "legendFormat": "generated"},
        {"expr": "rate(llamacpp:prompt_tokens_total{job=\"gpu-host-llama\"}[5m])", "legendFormat": "prompt ingested"}
      ]
    },
    {
      "id": 71,
      "title": "Decode Speed",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Tokens divided by the seconds actually spent on them, so idle time cancels out. These are the numbers the server writes to its own log as `print_timing` — generation sits around 46 t/s on this rig, prompt eval an order faster. A drop in generation with GPU clocks unchanged points at KV cache pressure or context growth, not thermals.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "axisLabel": "tok/s"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(llamacpp:tokens_predicted_total{job=\"gpu-host-llama\"}[5m]) / rate(llamacpp:tokens_predicted_seconds_total{job=\"gpu-host-llama\"}[5m])", "legendFormat": "generation"},
        {"expr": "rate(llamacpp:prompt_tokens_total{job=\"gpu-host-llama\"}[5m]) / rate(llamacpp:prompt_seconds_total{job=\"gpu-host-llama\"}[5m])", "legendFormat": "prompt eval"}
      ]
    },
    {
      "id": 72,
      "title": "Requests",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "This variant runs -np 1, so there is exactly one slot: processing is only ever 0 or 1, and a second caller shows up as deferred rather than sharing the GPU. Sustained deferred means the single slot is the bottleneck — the fix is more slots, which costs KV pool, not a faster card.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 20, "showPoints": "never", "drawStyle": "line", "lineInterpolation": "stepAfter"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "llamacpp:requests_processing{job=\"gpu-host-llama\"}", "legendFormat": "processing"},
        {"expr": "llamacpp:requests_deferred{job=\"gpu-host-llama\"}", "legendFormat": "deferred"}
      ]
    },
    {
      "id": 73,
      "title": "Speculative Gain (MTP)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 31},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Tokens emitted per llama_decode() call. The GGUF embeds an MTP head driven at --spec-draft-n-max 2, so the ceiling is 3 (one base token plus two drafted); 1.0 means the drafter is being rejected every time and is pure overhead. This is the only Prometheus-visible proxy for draft acceptance — the exporter has no metric for it, the server only writes `draft acceptance` to its log.",
      "options": {
        "tooltip": {"mode": "single", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 3,
          "decimals": 2,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "axisLabel": "tok / decode"},
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1.5},
              {"color": "green", "value": 2.2}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(llamacpp:tokens_predicted_total{job=\"gpu-host-llama\"}[5m]) / rate(llamacpp:n_decode_total{job=\"gpu-host-llama\"}[5m])", "legendFormat": "tokens per decode"}
      ]
    },
    {
      "id": 74,
      "title": "Server Availability",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 31},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Gaps here are expected, not faults. gpu-host runs a variant-switching estate — launch.sh tears the container down and brings a different model up, and the target is down in between. There is deliberately no alert rule on this job for that reason. A gap that never recovers means the new variant bound a different port than 8090, or was started without metrics enabled.",
      "options": {
        "tooltip": {"mode": "single", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 25, "showPoints": "never", "lineInterpolation": "stepAfter"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "up{job=\"gpu-host-llama\"}", "legendFormat": "llama.cpp server"}
      ]
    },

    {
      "id": 102,
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39},
      "panels": []
    },
    {
      "id": 40,
      "title": "CPU by Mode",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Stacked across all cores, idle excluded. Total height is overall busy percentage.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {"lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "avg by(mode) (rate(node_cpu_seconds_total{job=\"gpu-host-node\",mode!=\"idle\"}[5m])) * 100", "legendFormat": "{{ mode }}"}
      ]
    },
    {
      "id": 52,
      "title": "Load Average",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Dashed line is core count — load sustained above it means the run queue is backing up.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "cores"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}
            ]
          }
        ]
      },
      "targets": [
        {"expr": "node_load1{job=\"gpu-host-node\"}", "legendFormat": "1m"},
        {"expr": "node_load5{job=\"gpu-host-node\"}", "legendFormat": "5m"},
        {"expr": "node_load15{job=\"gpu-host-node\"}", "legendFormat": "15m"},
        {"expr": "count(count by(cpu) (node_cpu_seconds_total{job=\"gpu-host-node\"}))", "legendFormat": "cores"}
      ]
    },

    {
      "id": 103,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 48},
      "panels": []
    },
    {
      "id": 41,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Used excludes cache and buffers (MemTotal - MemAvailable). Total is drawn as a ceiling reference.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "total"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}
            ]
          }
        ]
      },
      "targets": [
        {"expr": "node_memory_MemTotal_bytes{job=\"gpu-host-node\"} - node_memory_MemAvailable_bytes{job=\"gpu-host-node\"}", "legendFormat": "used"},
        {"expr": "node_memory_Cached_bytes{job=\"gpu-host-node\"}", "legendFormat": "cached"},
        {"expr": "node_memory_Buffers_bytes{job=\"gpu-host-node\"}", "legendFormat": "buffers"},
        {"expr": "node_memory_MemTotal_bytes{job=\"gpu-host-node\"}", "legendFormat": "total"}
      ]
    },
    {
      "id": 42,
      "title": "Swap",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Any sustained swap use on a host serving a 27B model is worth investigating.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "total"},
            "properties": [
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}
            ]
          }
        ]
      },
      "targets": [
        {"expr": "node_memory_SwapTotal_bytes{job=\"gpu-host-node\"} - node_memory_SwapFree_bytes{job=\"gpu-host-node\"}", "legendFormat": "used"},
        {"expr": "node_memory_SwapTotal_bytes{job=\"gpu-host-node\"}", "legendFormat": "total"}
      ]
    },

    {
      "id": 104,
      "type": "row",
      "title": "Disk",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 57},
      "panels": []
    },
    {
      "id": 50,
      "title": "Filesystem Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 58},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "1 - (node_filesystem_avail_bytes{job=\"gpu-host-node\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"gpu-host-node\",fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{ mountpoint }}"}
      ]
    },
    {
      "id": 53,
      "title": "Disk I/O",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 58},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Reads above the axis, writes below. Physical devices only.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "axisSoftMin": 0}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total{job=\"gpu-host-node\",device!~\"loop.*|dm-.*\"}[5m])", "legendFormat": "{{ device }} read"},
        {"expr": "-rate(node_disk_written_bytes_total{job=\"gpu-host-node\",device!~\"loop.*|dm-.*\"}[5m])", "legendFormat": "{{ device }} write"}
      ]
    },

    {
      "id": 105,
      "type": "row",
      "title": "Network",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 66},
      "panels": []
    },
    {
      "id": 51,
      "title": "Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 67},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Receive above the axis, transmit below. Physical and Tailscale interfaces only; docker bridges excluded.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "axisSoftMin": 0}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} rx"},
        {"expr": "-rate(node_network_transmit_bytes_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} tx"}
      ]
    },
    {
      "id": 54,
      "title": "Errors & Drops",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 67},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Flat zero is the expected state. Anything sustained here points at cabling, the NIC, or an overloaded link.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["max"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {"expr": "rate(node_network_receive_errs_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} rx errs"},
        {"expr": "rate(node_network_transmit_errs_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} tx errs"},
        {"expr": "rate(node_network_receive_drop_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} rx drops"},
        {"expr": "rate(node_network_transmit_drop_total{job=\"gpu-host-node\",device=~\"enp.*|eth.*|tailscale.*\"}[5m])", "legendFormat": "{{ device }} tx drops"}
      ]
    },

    {
      "id": 106,
      "type": "row",
      "title": "Fans & Temps",
