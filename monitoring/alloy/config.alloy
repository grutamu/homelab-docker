// Discover all running containers via the Docker socket and ship their
// logs to Loki, labelled by container, compose service, and stack.

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // "/plex" -> "plex"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "stack"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  labels        = { host = "docker01" }
  forward_to    = [loki.write.default.receiver]
}

// docker01 host logs (systemd journal)

discovery.relabel "journal" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "host" {
  path          = "/var/log/journal"
  relabel_rules = discovery.relabel.journal.rules
  labels        = { host = "docker01", job = "journal" }
  max_age       = "12h"
  forward_to    = [loki.write.default.receiver]
}

// Syslog receiver for the rest of the environment (Proxmox, TrueNAS,
// UDM Pro, AdGuard host, ...). TCP expects RFC5424; UDP expects RFC3164,
// which is what most appliances send by default.

discovery.relabel "syslog" {
  targets = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
}

loki.source.syslog "network" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "tcp"
    syslog_format = "rfc5424"
    labels        = { job = "syslog" }
  }

  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "syslog" }
  }

  relabel_rules = discovery.relabel.syslog.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
